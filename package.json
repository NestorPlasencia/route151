{
  "name": "route151",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/build-ocr-assets.mjs && node scripts/build-emulator-assets.mjs",
    "build": "next build",
    "postbuild": "node scripts/build-offline-manifests.mjs",
    "start": "next start",
    "pwa:icons": "node scripts/build-pwa-icons.mjs",
    "sav:samples": "node scripts/fetch-save-samples.mjs",
    "sav:catalog": "python scripts/frlg/build-save-catalog.py",
    "emulator:assets": "node scripts/build-emulator-assets.mjs",
    "ocr:assets": "node scripts/build-ocr-assets.mjs",
    "lint": "oxlint",
    "test": "node --test tests/*.test.mjs && python -m unittest discover -s tests -p test_*.py",
    "check:data": "python scripts/check-data.py",
    "format": "oxfmt"
  },
  "dependencies": {
    "@types/leaflet": "^1.9.22",
    "leaflet": "^1.9.4",
    "lucide-react": "1.31.0",
    "next": "16.3.5",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  },
  "type": "module"
}
